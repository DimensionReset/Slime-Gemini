{
	"manifest_version": 3,
	"name": "Slime Gemini",
	"version": "1.0",
	"description": "Get rid of Gemini everywhere. Begone!",

	"icons": {
		"16": "images/extension-logo-16.png",
		"32": "images/extension-logo-32.png",
		"48": "images/extension-logo-48.png",
        "64": "images/extension-logo-64.png",
		"128": "images/extension-logo-128.png"
	},

	"action": {
		"default_popup": "popup.html",
        "default_icon": "images/extension-logo.png"
	},

	"permissions": ["webNavigation", "storage"],

	"background": {
		"service_worker": "scripts/main/background.js"
	},

	"content_scripts": [
		{
			"matches": ["https://www.google.com/search*"],
			"js": ["scripts/main/tab-remover.js"],
			"run_at": "document_start"
		},

		{
			"matches": ["https://www.google.com/search*", "https://gemini.google.com/*"],
			"js": ["scripts/main/overlay-adder.js"],
			"run_at": "document_start"
		},

		{
			"matches": ["https://docs.google.com/*"],
			"js": ["scripts/main/docs-remover.js"],
			"run_at": "document_start"
		}
	]
}
